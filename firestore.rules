rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidPairId(id) {
      return id is string && id.size() >= 3 && id.size() <= 260 && id.matches('^[a-zA-Z0-9_\\-]+__[a-zA-Z0-9_\\-]+$');
    }

    function isValidNotificationId(id) {
      return id is string && id.size() >= 1 && id.size() <= 360 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidNotificationUpdate(next, prev) {
      return next.diff(prev).affectedKeys().hasOnly(['isRead', 'isDismissed', 'readAt'])
        && next.diff(prev).affectedKeys().size() >= 1
        && next.isRead is bool
        && next.isDismissed is bool
        && (!prev.isRead || next.isRead)
        && (!prev.isDismissed || next.isDismissed)
        && (
          next.readAt == prev.readAt
          || (next.isRead == true && next.readAt == request.time)
        );
    }

    function isValidNotificationSettings(data, userId) {
      return data.keys().hasAll([
          'userId',
          'enabled',
          'socialEnabled',
          'followersEnabled',
          'communitiesEnabled',
          'messagingEnabled',
          'groupsEnabled',
          'systemEnabled',
          'popupEnabled',
          'soundEnabled',
          'quietHoursEnabled',
          'quietHoursStart',
          'quietHoursEnd',
          'timezone',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId',
          'enabled',
          'socialEnabled',
          'followersEnabled',
          'communitiesEnabled',
          'messagingEnabled',
          'groupsEnabled',
          'systemEnabled',
          'popupEnabled',
          'soundEnabled',
          'quietHoursEnabled',
          'quietHoursStart',
          'quietHoursEnd',
          'timezone',
          'updatedAt'
        ])
        && data.userId == userId
        && data.enabled is bool
        && data.socialEnabled is bool
        && data.followersEnabled is bool
        && data.communitiesEnabled is bool
        && data.messagingEnabled is bool
        && data.groupsEnabled is bool
        && data.systemEnabled is bool
        && data.popupEnabled is bool
        && data.soundEnabled is bool
        && data.quietHoursEnabled is bool
        && data.quietHoursStart is string
        && data.quietHoursStart.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && data.quietHoursEnd is string
        && data.quietHoursEnd.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && data.timezone is string
        && data.timezone.size() >= 1
        && data.timezone.size() <= 80
        && data.updatedAt == request.time;
    }

    function isValidSlug(slug) {
      return slug is string && slug.size() >= 3 && slug.size() <= 40 && slug.matches('^[a-z0-9]+(?:-[a-z0-9]+)*$');
    }

    function isValidUsernameFormat(username) {
      return username is string && username.size() >= 3 && username.size() <= 20 && username.matches('^[a-zA-Z0-9_]{3,20}$');
    }

    function isValidUsernameLower(usernameLower) {
      return usernameLower is string && usernameLower.size() >= 3 && usernameLower.size() <= 20 && usernameLower.matches('^[a-z0-9_]{3,20}$');
    }

    function isValidOptionalHttpsUrl(url, maxLen) {
      return url is string && url.size() <= maxLen && (url == '' || url.matches('^https://.+'));
    }

    function isValidCommunityCategory(category) {
      return category in [
        'Shonen',
        'Seinen',
        'Shojo',
        'Mecha & Sci-Fi',
        'Fantasy & Isekai',
        'Slice of Life',
        'Animation & Sakuga',
        'Manga & Light Novels',
        'General'
      ];
    }

    function isBlockedBetween(uidA, uidB) {
      return exists(/databases/$(database)/documents/blocks/$(uidA + '__' + uidB))
        || exists(/databases/$(database)/documents/blocks/$(uidB + '__' + uidA));
    }

    function isCommunityExists(communityId) {
      return exists(/databases/$(database)/documents/communities/$(communityId));
    }

    function isCommunityActive(communityId) {
      return isCommunityExists(communityId)
        && get(/databases/$(database)/documents/communities/$(communityId)).data.status == 'active';
    }

    function isCommunityPublic(communityId) {
      return isCommunityExists(communityId)
        && get(/databases/$(database)/documents/communities/$(communityId)).data.visibility == 'public';
    }

    function isCommunityMember(communityId, uid) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/communityMemberships/$(communityId + '__' + uid));
    }

    function isCommunityModerator(communityId, uid) {
      return isCommunityMember(communityId, uid)
        && get(/databases/$(database)/documents/communityMemberships/$(communityId + '__' + uid)).data.role in ['owner', 'moderator'];
    }

    function isCommunityOwner(communityId, uid) {
      return isSignedIn()
        && isCommunityExists(communityId)
        && get(/databases/$(database)/documents/communities/$(communityId)).data.ownerId == uid;
    }

    function canReadCommunityPosts(communityId) {
      return isCommunityActive(communityId)
        && (isCommunityPublic(communityId) || isCommunityMember(communityId, request.auth.uid));
    }

    function canParticipateInCommunity(communityId) {
      return isEmailVerified()
        && isCommunityActive(communityId)
        && isCommunityMember(communityId, request.auth.uid);
    }

    function isValidUserAccount(data, userId) {
      return data.keys().hasAll([
          'uid',
          'username',
          'usernameLowercase',
          'displayName',
          'email',
          'bio',
          'avatarUrl',
          'emailVerified',
          'accountStatus',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'username',
          'usernameLowercase',
          'displayName',
          'email',
          'bio',
          'avatarUrl',
          'emailVerified',
          'accountStatus',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && data.uid == userId
        && isValidUsernameFormat(data.username)
        && isValidUsernameLower(data.usernameLowercase)
        && data.username.lower() == data.usernameLowercase
        && data.displayName is string
        && data.displayName.size() >= 2
        && data.displayName.size() <= 40
        && data.email is string
        && data.email.size() >= 5
        && data.email.size() <= 254
        && data.bio is string
        && data.bio.size() <= 280
        && isValidOptionalHttpsUrl(data.avatarUrl, 500)
        && data.emailVerified is bool
        && data.accountStatus in ['pending_verification', 'active']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPublicProfile(data, userId) {
      return data.keys().hasAll([
          'uid',
          'username',
          'usernameLowercase',
          'displayName',
          'bio',
          'avatarUrl',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'username',
          'usernameLowercase',
          'displayName',
          'bio',
          'avatarUrl',
          'followersCount',
          'followingCount',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && data.uid == userId
        && isValidUsernameFormat(data.username)
        && isValidUsernameLower(data.usernameLowercase)
        && data.username.lower() == data.usernameLowercase
        && data.displayName is string
        && data.displayName.size() >= 2
        && data.displayName.size() <= 40
        && data.bio is string
        && data.bio.size() <= 280
        && isValidOptionalHttpsUrl(data.avatarUrl, 500)
        && (!('followersCount' in data) || (data.followersCount is int && data.followersCount >= 0))
        && (!('followingCount' in data) || (data.followingCount is int && data.followingCount >= 0))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUsernameReservation(data, usernameLower) {
      return data.keys().hasAll(['uid', 'username', 'createdAt'])
        && data.keys().hasOnly(['uid', 'username', 'createdAt'])
        && data.uid is string
        && isValidId(data.uid)
        && isValidUsernameFormat(data.username)
        && data.username.lower() == usernameLower
        && data.createdAt is timestamp;
    }

    function isValidPost(data, postId) {
      return data.keys().hasAll([
          'id',
          'authorId',
          'authorUsername',
          'authorDisplayName',
          'authorAvatarUrl',
          'content',
          'animeTitle',
          'hasSpoiler',
          'spoilerLabel',
          'imageUrl',
          'imagePath',
          'likeCount',
          'commentCount',
          'isEdited',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'authorId',
          'authorUsername',
          'authorDisplayName',
          'authorAvatarUrl',
          'content',
          'animeTitle',
          'hasSpoiler',
          'spoilerLabel',
          'imageUrl',
          'imagePath',
          'likeCount',
          'commentCount',
          'isEdited',
          'createdAt',
          'updatedAt'
        ])
        && data.id is string
        && data.id == postId
        && data.authorId is string
        && isValidId(data.authorId)
        && isValidUsernameFormat(data.authorUsername)
        && data.authorDisplayName is string
        && data.authorDisplayName.size() >= 2
        && data.authorDisplayName.size() <= 40
        && isValidOptionalHttpsUrl(data.authorAvatarUrl, 500)
        && data.content is string
        && data.content.size() >= 1
        && data.content.size() <= 1500
        && data.animeTitle is string
        && data.animeTitle.size() <= 100
        && data.hasSpoiler is bool
        && data.spoilerLabel is string
        && data.spoilerLabel.size() <= 80
        && isValidOptionalHttpsUrl(data.imageUrl, 1000)
        && data.imagePath is string
        && data.imagePath.size() <= 300
        && data.likeCount is int
        && data.likeCount >= 0
        && data.commentCount is int
        && data.commentCount >= 0
        && data.isEdited is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidComment(data, postId, commentId) {
      return data.keys().hasAll([
          'id',
          'postId',
          'authorId',
          'authorUsername',
          'authorDisplayName',
          'authorAvatarUrl',
          'content',
          'parentCommentId',
          'replyToAuthorUsername',
          'hasSpoiler',
          'isEdited',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'postId',
          'authorId',
          'authorUsername',
          'authorDisplayName',
          'authorAvatarUrl',
          'content',
          'parentCommentId',
          'replyToAuthorUsername',
          'hasSpoiler',
          'isEdited',
          'createdAt',
          'updatedAt'
        ])
        && data.id is string
        && data.id == commentId
        && data.postId is string
        && data.postId == postId
        && data.authorId is string
        && isValidId(data.authorId)
        && isValidUsernameFormat(data.authorUsername)
        && data.authorDisplayName is string
        && data.authorDisplayName.size() >= 2
        && data.authorDisplayName.size() <= 40
        && isValidOptionalHttpsUrl(data.authorAvatarUrl, 500)
        && data.content is string
        && data.content.size() >= 1
        && data.content.size() <= 800
        && data.parentCommentId is string
        && data.parentCommentId.size() <= 128
        && data.replyToAuthorUsername is string
        && data.replyToAuthorUsername.size() <= 20
        && data.hasSpoiler is bool
        && data.isEdited is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidReaction(data) {
      return data.keys().hasAll(['uid', 'type', 'createdAt'])
        && data.keys().hasOnly(['uid', 'type', 'createdAt'])
        && data.uid is string
        && isValidId(data.uid)
        && data.type == 'like'
        && data.createdAt is timestamp;
    }

    function isValidFollow(data, followId) {
      return data.keys().hasAll(['id', 'followerId', 'followingId', 'createdAt'])
        && data.keys().hasOnly(['id', 'followerId', 'followingId', 'createdAt'])
        && data.id is string
        && data.id == followId
        && isValidId(data.followerId)
        && isValidId(data.followingId)
        && data.followerId != data.followingId
        && followId == data.followerId + '__' + data.followingId
        && data.createdAt is timestamp;
    }

    function isValidBlock(data, blockId) {
      return data.keys().hasAll(['id', 'blockerId', 'blockedId', 'blockedUsername', 'createdAt'])
        && data.keys().hasOnly(['id', 'blockerId', 'blockedId', 'blockedUsername', 'createdAt'])
        && data.id is string
        && data.id == blockId
        && isValidId(data.blockerId)
        && isValidId(data.blockedId)
        && data.blockerId != data.blockedId
        && blockId == data.blockerId + '__' + data.blockedId
        && isValidUsernameFormat(data.blockedUsername)
        && data.createdAt is timestamp;
    }

    function isValidConversationId(id) {
      return id is string && id.size() >= 1 && id.size() <= 300 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidMemberDocId(id) {
      return id is string && id.size() >= 3 && id.size() <= 440 && id.matches('^[a-zA-Z0-9_\\-]+__[a-zA-Z0-9_\\-]+$');
    }

    function directConvId(uidA, uidB) {
      return 'dm__' + (uidA < uidB ? uidA + '__' + uidB : uidB + '__' + uidA);
    }

    function isConversationExists(conversationId) {
      return exists(/databases/$(database)/documents/conversations/$(conversationId));
    }

    function isConversationParticipant(conversationId, uid) {
      return isSignedIn()
        && isConversationExists(conversationId)
        && uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
    }

    function isConversationActive(conversationId) {
      return isConversationExists(conversationId)
        && get(/databases/$(database)/documents/conversations/$(conversationId)).data.status == 'active';
    }

    function isConversationAdmin(conversationId, uid) {
      return isConversationParticipant(conversationId, uid)
        && get(/databases/$(database)/documents/conversations/$(conversationId)).data.type == 'group'
        && uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.adminIds;
    }

    function isConversationOwner(conversationId, uid) {
      return isConversationParticipant(conversationId, uid)
        && get(/databases/$(database)/documents/conversations/$(conversationId)).data.type == 'group'
        && get(/databases/$(database)/documents/conversations/$(conversationId)).data.ownerId == uid;
    }

    function recipientAllowsMessageRequest(senderId, recipientId) {
      return !isBlockedBetween(senderId, recipientId)
        && exists(/databases/$(database)/documents/publicProfiles/$(recipientId))
        && (
          !exists(/databases/$(database)/documents/messageSettings/$(recipientId))
          || (
            get(/databases/$(database)/documents/messageSettings/$(recipientId)).data.allowRequests == true
            && (
              get(/databases/$(database)/documents/messageSettings/$(recipientId)).data.requestPermission == 'everyone'
              || (
                get(/databases/$(database)/documents/messageSettings/$(recipientId)).data.requestPermission == 'following'
                && exists(/databases/$(database)/documents/follows/$(recipientId + '__' + senderId))
              )
              || (
                get(/databases/$(database)/documents/messageSettings/$(recipientId)).data.requestPermission == 'mutuals'
                && exists(/databases/$(database)/documents/follows/$(recipientId + '__' + senderId))
                && exists(/databases/$(database)/documents/follows/$(senderId + '__' + recipientId))
              )
            )
          )
        );
    }

    function isValidMessageSettings(data, userId) {
      return data.keys().hasAll([
          'uid',
          'allowRequests',
          'requestPermission',
          'readReceiptsEnabled',
          'onlineStatusVisible',
          'typingIndicatorsEnabled',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'allowRequests',
          'requestPermission',
          'readReceiptsEnabled',
          'onlineStatusVisible',
          'typingIndicatorsEnabled',
          'updatedAt'
        ])
        && data.uid is string
        && data.uid == userId
        && data.allowRequests is bool
        && data.requestPermission in ['everyone', 'following', 'mutuals']
        && data.readReceiptsEnabled is bool
        && data.onlineStatusVisible is bool
        && data.typingIndicatorsEnabled is bool
        && data.updatedAt is timestamp;
    }

    function isValidUserPresence(data, userId) {
      return data.keys().hasAll(['uid', 'status', 'visible', 'lastActiveAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'status', 'visible', 'lastActiveAt', 'updatedAt'])
        && data.uid is string
        && data.uid == userId
        && data.status in ['online', 'away']
        && data.visible is bool
        && data.lastActiveAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidConversation(data, conversationId) {
      return data.keys().hasAll([
          'id',
          'type',
          'directKey',
          'name',
          'description',
          'avatarUrl',
          'avatarPath',
          'ownerId',
          'adminIds',
          'participantIds',
          'lastMessageText',
          'lastMessageSenderId',
          'lastMessageType',
          'lastMessageAt',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'type',
          'directKey',
          'name',
          'description',
          'avatarUrl',
          'avatarPath',
          'ownerId',
          'adminIds',
          'participantIds',
          'lastMessageText',
          'lastMessageSenderId',
          'lastMessageType',
          'lastMessageAt',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.id is string
        && data.id == conversationId
        && data.type in ['direct', 'group']
        && data.directKey is string
        && data.directKey.size() <= 280
        && data.name is string
        && data.name.size() <= 60
        && (data.type == 'direct' || data.name.size() >= 2)
        && data.description is string
        && data.description.size() <= 300
        && isValidOptionalHttpsUrl(data.avatarUrl, 1000)
        && data.avatarPath is string
        && data.avatarPath.size() <= 300
        && data.ownerId is string
        && data.ownerId.size() <= 128
        && data.adminIds is list
        && data.adminIds.size() <= 25
        && data.participantIds is list
        && data.participantIds.size() >= 1
        && data.participantIds.size() <= 25
        && (
          (data.type == 'direct' && data.participantIds.size() == 2 && data.ownerId == '' && data.adminIds.size() == 0 && data.directKey != '')
          || (data.type == 'group' && data.ownerId != '' && data.ownerId in data.participantIds && data.ownerId in data.adminIds && data.directKey == '')
        )
        && data.lastMessageText is string
        && data.lastMessageText.size() <= 200
        && data.lastMessageSenderId is string
        && data.lastMessageSenderId.size() <= 128
        && data.lastMessageType in ['text', 'system', 'none']
        && data.lastMessageAt is timestamp
        && data.status in ['active', 'archived']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidConversationMember(data, memberDocId) {
      return data.keys().hasAll([
          'id',
          'conversationId',
          'userId',
          'username',
          'displayName',
          'avatarUrl',
          'role',
          'unreadCount',
          'lastReadAt',
          'muted',
          'archived',
          'joinedAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'conversationId',
          'userId',
          'username',
          'displayName',
          'avatarUrl',
          'role',
          'unreadCount',
          'lastReadAt',
          'muted',
          'archived',
          'joinedAt',
          'updatedAt'
        ])
        && data.id is string
        && data.id == memberDocId
        && isValidConversationId(data.conversationId)
        && isValidId(data.userId)
        && memberDocId == data.conversationId + '__' + data.userId
        && isValidUsernameFormat(data.username)
        && data.displayName is string
        && data.displayName.size() >= 2
        && data.displayName.size() <= 40
        && isValidOptionalHttpsUrl(data.avatarUrl, 500)
        && data.role in ['owner', 'admin', 'member']
        && data.unreadCount is int
        && data.unreadCount >= 0
        && (data.lastReadAt == null || data.lastReadAt is timestamp)
        && data.muted is bool
        && data.archived is bool
        && data.joinedAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMessage(data, conversationId, messageId) {
      return data.keys().hasAll([
          'id',
          'conversationId',
          'senderId',
          'senderUsername',
          'senderDisplayName',
          'senderAvatarUrl',
          'messageType',
          'text',
          'replyToMessageId',
          'replyToPreview',
          'replyToSenderName',
          'editedAt',
          'deletedAt',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'id',
          'conversationId',
          'senderId',
          'senderUsername',
          'senderDisplayName',
          'senderAvatarUrl',
          'messageType',
          'text',
          'replyToMessageId',
          'replyToPreview',
          'replyToSenderName',
          'editedAt',
          'deletedAt',
          'createdAt'
        ])
        && data.id is string
        && data.id == messageId
        && data.conversationId is string
        && data.conversationId == conversationId
        && data.senderId is string
        && isValidId(data.senderId)
        && isValidUsernameFormat(data.senderUsername)
        && data.senderDisplayName is string
        && data.senderDisplayName.size() >= 2
        && data.senderDisplayName.size() <= 40
        && isValidOptionalHttpsUrl(data.senderAvatarUrl, 500)
        && data.messageType in ['text', 'system']
        && data.text is string
        && data.text.size() <= 2000
        && (data.deletedAt != null || data.text.size() >= 1)
        && data.replyToMessageId is string
        && data.replyToMessageId.size() <= 128
        && data.replyToPreview is string
        && data.replyToPreview.size() <= 160
        && data.replyToSenderName is string
        && data.replyToSenderName.size() <= 40
        && (data.editedAt == null || data.editedAt is timestamp)
        && (data.deletedAt == null || data.deletedAt is timestamp)
        && data.createdAt is timestamp;
    }

    function isValidMessageRequest(data, requestId) {
      return data.keys().hasAll([
          'id',
          'senderId',
          'senderUsername',
          'senderDisplayName',
          'senderAvatarUrl',
          'recipientId',
          'recipientUsername',
          'recipientDisplayName',
          'recipientAvatarUrl',
          'initialMessage',
          'status',
          'conversationId',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'senderId',
          'senderUsername',
          'senderDisplayName',
          'senderAvatarUrl',
          'recipientId',
          'recipientUsername',
          'recipientDisplayName',
          'recipientAvatarUrl',
          'initialMessage',
          'status',
          'conversationId',
          'createdAt',
          'updatedAt'
        ])
        && data.id is string
        && data.id == requestId
        && isValidId(data.senderId)
        && isValidUsernameFormat(data.senderUsername)
        && data.senderDisplayName is string
        && data.senderDisplayName.size() >= 2
        && data.senderDisplayName.size() <= 40
        && isValidOptionalHttpsUrl(data.senderAvatarUrl, 500)
        && isValidId(data.recipientId)
        && data.senderId != data.recipientId
        && requestId == data.senderId + '__' + data.recipientId
        && isValidUsernameFormat(data.recipientUsername)
        && data.recipientDisplayName is string
        && data.recipientDisplayName.size() >= 2
        && data.recipientDisplayName.size() <= 40
        && isValidOptionalHttpsUrl(data.recipientAvatarUrl, 500)
        && data.initialMessage is string
        && data.initialMessage.size() >= 1
        && data.initialMessage.size() <= 1000
        && data.status in ['pending', 'accepted', 'declined', 'cancelled']
        && data.conversationId is string
        && data.conversationId.size() <= 300
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTypingDoc(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'isTyping', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'isTyping', 'updatedAt'])
        && data.uid is string
        && data.uid == userId
        && data.displayName is string
        && data.displayName.size() >= 2
        && data.displayName.size() <= 40
        && data.isTyping is bool
        && data.updatedAt is timestamp;
    }

    function isValidMessageRateLimit(data, userId) {
      return data.keys().hasAll(['uid', 'lastMessageAt', 'lastRequestAt', 'lastGroupCreatedAt'])
        && data.keys().hasOnly(['uid', 'lastMessageAt', 'lastRequestAt', 'lastGroupCreatedAt'])
        && data.uid is string
        && data.uid == userId
        && (data.lastMessageAt == null || data.lastMessageAt is timestamp)
        && (data.lastRequestAt == null || data.lastRequestAt is timestamp)
        && (data.lastGroupCreatedAt == null || data.lastGroupCreatedAt is timestamp);
    }

    function isValidReport(data, reportId) {
      return data.keys().hasAll([
          'id',
          'reporterId',
          'targetType',
          'targetId',
          'postId',
          'targetAuthorId',
          'reason',
          'details',
          'status',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'id',
          'reporterId',
          'targetType',
          'targetId',
          'postId',
          'communityId',
          'conversationId',
          'targetAuthorId',
          'reason',
          'details',
          'status',
          'createdAt'
        ])
        && data.id is string
        && data.id == reportId
        && isValidId(data.reporterId)
        && data.targetType in ['post', 'comment', 'community', 'message', 'conversation']
        && isValidConversationId(data.targetId)
        && isValidConversationId(data.postId)
        && (!('communityId' in data) || (data.communityId is string && data.communityId.size() <= 128))
        && (!('conversationId' in data) || (data.conversationId is string && data.conversationId.size() <= 300))
        && isValidId(data.targetAuthorId)
        && data.reason in [
          'spam',
          'harassment',
          'unmarked_spoiler',
          'hate_speech',
          'inappropriate_community',
          'rule_violation',
          'other'
        ]
        && data.details is string
        && data.details.size() <= 500
        && data.status == 'open'
        && data.createdAt is timestamp;
    }

    function isValidCommunity(data, communityId) {
      return data.keys().hasAll([
          'id',
          'name',
          'nameLowercase',
          'slug',
          'description',
          'avatarUrl',
          'avatarPath',
          'coverUrl',
          'coverPath',
          'category',
          'animeTags',
          'rules',
          'ownerId',
          'moderatorIds',
          'memberCount',
          'visibility',
          'status',
          'isFeatured',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'name',
          'nameLowercase',
          'slug',
          'description',
          'avatarUrl',
          'avatarPath',
          'coverUrl',
          'coverPath',
          'category',
          'animeTags',
          'rules',
          'ownerId',
          'moderatorIds',
          'memberCount',
          'visibility',
          'status',
          'isFeatured',
          'createdAt',
          'updatedAt'
        ])
        && data.id is string
        && data.id == communityId
        && data.name is string
        && data.name.size() >= 3
        && data.name.size() <= 50
        && data.nameLowercase is string
        && data.nameLowercase == data.name.lower()
        && isValidSlug(data.slug)
        && data.description is string
        && data.description.size() >= 10
        && data.description.size() <= 500
        && isValidOptionalHttpsUrl(data.avatarUrl, 1000)
        && data.avatarPath is string
        && data.avatarPath.size() <= 300
        && isValidOptionalHttpsUrl(data.coverUrl, 1000)
        && data.coverPath is string
        && data.coverPath.size() <= 300
        && isValidCommunityCategory(data.category)
        && data.animeTags is list
        && data.animeTags.size() <= 8
        && (data.animeTags.size() == 0 || (data.animeTags[0] is string && data.animeTags[0].size() >= 1 && data.animeTags[0].size() <= 30))
        && data.rules is list
        && data.rules.size() <= 10
        && (data.rules.size() == 0 || (data.rules[0] is string && data.rules[0].size() >= 3 && data.rules[0].size() <= 180))
        && data.ownerId is string
        && isValidId(data.ownerId)
        && data.moderatorIds is list
        && data.moderatorIds.size() >= 1
        && data.moderatorIds.size() <= 25
        && data.ownerId in data.moderatorIds
        && data.memberCount is int
        && data.memberCount >= 0
        && data.visibility in ['public', 'private']
        && data.status in ['active', 'archived']
        && data.isFeatured is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCommunitySlug(data, slug) {
      return data.keys().hasAll(['communityId', 'slug', 'ownerId', 'createdAt'])
        && data.keys().hasOnly(['communityId', 'slug', 'ownerId', 'createdAt'])
        && isValidId(data.communityId)
        && isValidSlug(data.slug)
        && data.slug == slug
        && isValidId(data.ownerId)
        && data.createdAt is timestamp;
    }

    function isValidCommunityMembership(data, membershipId) {
      return data.keys().hasAll([
          'id',
          'communityId',
          'userId',
          'username',
          'displayName',
          'avatarUrl',
          'role',
          'joinedAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'communityId',
          'userId',
          'username',
          'displayName',
          'avatarUrl',
          'role',
          'joinedAt',
          'updatedAt'
        ])
        && data.id is string
        && data.id == membershipId
        && isValidId(data.communityId)
        && isValidId(data.userId)
        && membershipId == data.communityId + '__' + data.userId
        && isValidUsernameFormat(data.username)
        && data.displayName is string
        && data.displayName.size() >= 2
        && data.displayName.size() <= 40
        && isValidOptionalHttpsUrl(data.avatarUrl, 500)
        && data.role in ['owner', 'moderator', 'member']
        && data.joinedAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCommunityJoinRequest(data, requestId) {
      return data.keys().hasAll([
          'id',
          'communityId',
          'userId',
          'username',
          'displayName',
          'avatarUrl',
          'message',
          'status',
          'reviewedBy',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'communityId',
          'userId',
          'username',
          'displayName',
          'avatarUrl',
          'message',
          'status',
          'reviewedBy',
          'createdAt',
          'updatedAt'
        ])
        && data.id is string
        && data.id == requestId
        && isValidId(data.communityId)
        && isValidId(data.userId)
        && requestId == data.communityId + '__' + data.userId
        && isValidUsernameFormat(data.username)
        && data.displayName is string
        && data.displayName.size() >= 2
        && data.displayName.size() <= 40
        && isValidOptionalHttpsUrl(data.avatarUrl, 500)
        && data.message is string
        && data.message.size() <= 300
        && data.status in ['pending', 'approved', 'rejected']
        && data.reviewedBy is string
        && data.reviewedBy.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Owner-only private account document (protects email and account status)
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserAccount(incoming(), userId)
        && incoming().email.lower() == request.auth.token.email.lower()
        && incoming().emailVerified == false
        && incoming().accountStatus == 'pending_verification'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/usernames/$(incoming().usernameLowercase))
        && existsAfter(/databases/$(database)/documents/publicProfiles/$(userId));

      allow update: if isValidId(userId)
        && isOwner(userId)
        && isEmailVerified()
        && isValidUserAccount(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().username == existing().username
        && incoming().usernameLowercase == existing().usernameLowercase
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            existing().emailVerified == false
            && incoming().emailVerified == true
            && existing().accountStatus == 'pending_verification'
            && incoming().accountStatus == 'active'
            && incoming().diff(existing()).affectedKeys().hasOnly(['emailVerified', 'accountStatus', 'updatedAt'])
          )
          ||
          (
            existing().emailVerified == true
            && existing().accountStatus == 'active'
            && incoming().emailVerified == existing().emailVerified
            && incoming().accountStatus == existing().accountStatus
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'bio', 'avatarUrl', 'updatedAt'])
          )
        );

      allow delete: if false;
    }

    // Public non-PII profile document
    match /publicProfiles/{userId} {
      allow get: if isValidId(userId);
      allow list: if false;

      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidPublicProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/users/$(userId))
        && existsAfter(/databases/$(database)/documents/usernames/$(incoming().usernameLowercase));

      allow update: if isValidId(userId)
        && isEmailVerified()
        && isValidPublicProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().username == existing().username
        && incoming().usernameLowercase == existing().usernameLowercase
        && incoming().createdAt == existing().createdAt
        && (
          (
            isOwner(userId)
            && incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'bio', 'avatarUrl', 'updatedAt'])
          )
          ||
          (
            !isOwner(userId)
            && incoming().updatedAt == existing().updatedAt
            && incoming().diff(existing()).affectedKeys().hasOnly(['followersCount'])
            && (
              (
                !exists(/databases/$(database)/documents/follows/$(request.auth.uid + '__' + userId))
                && existsAfter(/databases/$(database)/documents/follows/$(request.auth.uid + '__' + userId))
                && (
                  ('followersCount' in existing() && incoming().followersCount == existing().followersCount + 1)
                  || (!('followersCount' in existing()) && incoming().followersCount == 1)
                )
              )
              ||
              (
                exists(/databases/$(database)/documents/follows/$(request.auth.uid + '__' + userId))
                && !existsAfter(/databases/$(database)/documents/follows/$(request.auth.uid + '__' + userId))
                && 'followersCount' in existing()
                && existing().followersCount >= 1
                && incoming().followersCount == existing().followersCount - 1
              )
            )
          )
          ||
          (
            isOwner(userId)
            && incoming().updatedAt == existing().updatedAt
            && incoming().diff(existing()).affectedKeys().hasOnly(['followingCount'])
            && (
              ('followingCount' in existing() && (incoming().followingCount == existing().followingCount + 1 || (existing().followingCount >= 1 && incoming().followingCount == existing().followingCount - 1)))
              || (!('followingCount' in existing()) && incoming().followingCount == 1)
            )
          )
        );

      allow delete: if false;
    }

    // Atomic username uniqueness registry
    match /usernames/{usernameLowercase} {
      allow get: if isValidUsernameLower(usernameLowercase);
      allow list: if false;

      allow create: if isValidUsernameLower(usernameLowercase)
        && isSignedIn()
        && !exists(/databases/$(database)/documents/usernames/$(usernameLowercase))
        && isValidUsernameReservation(incoming(), usernameLowercase)
        && incoming().uid == request.auth.uid
        && incoming().createdAt == request.time
        && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid))
        && existsAfter(/databases/$(database)/documents/publicProfiles/$(request.auth.uid));

      allow update, delete: if false;
    }

    // Global Community Posts
    match /posts/{postId} {
      allow get: if isValidId(postId);
      allow list: if true;

      allow create: if isValidId(postId)
        && isEmailVerified()
        && isValidPost(incoming(), postId)
        && incoming().authorId == request.auth.uid
        && incoming().likeCount == 0
        && incoming().commentCount == 0
        && incoming().isEdited == false
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/publicProfiles/$(request.auth.uid))
        && existsAfter(/databases/$(database)/documents/postRateLimits/$(request.auth.uid))
        && (
          !exists(/databases/$(database)/documents/postRateLimits/$(request.auth.uid))
          || request.time >= get(/databases/$(database)/documents/postRateLimits/$(request.auth.uid)).data.lastPostAt + duration.value(10, 's')
        );

      allow update: if isValidId(postId)
        && isEmailVerified()
        && isValidPost(incoming(), postId)
        && incoming().id == existing().id
        && incoming().authorId == existing().authorId
        && incoming().authorUsername == existing().authorUsername
        && incoming().createdAt == existing().createdAt
        && (
          (
            isOwner(existing().authorId)
            && incoming().likeCount == existing().likeCount
            && incoming().commentCount == existing().commentCount
            && incoming().isEdited == true
            && incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly(['content', 'animeTitle', 'hasSpoiler', 'spoilerLabel', 'isEdited', 'updatedAt'])
          )
          ||
          (
            !isBlockedBetween(existing().authorId, request.auth.uid)
            && incoming().updatedAt == existing().updatedAt
            && incoming().diff(existing()).affectedKeys().hasOnly(['likeCount'])
            && (
              (
                !exists(/databases/$(database)/documents/posts/$(postId)/reactions/$(request.auth.uid))
                && existsAfter(/databases/$(database)/documents/posts/$(postId)/reactions/$(request.auth.uid))
                && incoming().likeCount == existing().likeCount + 1
              )
              ||
              (
                exists(/databases/$(database)/documents/posts/$(postId)/reactions/$(request.auth.uid))
                && !existsAfter(/databases/$(database)/documents/posts/$(postId)/reactions/$(request.auth.uid))
                && existing().likeCount >= 1
                && incoming().likeCount == existing().likeCount - 1
              )
            )
          )
          ||
          (
            !isBlockedBetween(existing().authorId, request.auth.uid)
            && incoming().updatedAt == existing().updatedAt
            && incoming().diff(existing()).affectedKeys().hasOnly(['commentCount'])
            && (
              incoming().commentCount == existing().commentCount + 1
              || (existing().commentCount >= 1 && incoming().commentCount == existing().commentCount - 1)
            )
          )
        );

      allow delete: if isValidId(postId)
        && isEmailVerified()
        && isOwner(existing().authorId);

      // Scalable per-user reactions subcollection
      match /reactions/{userId} {
        allow get: if isValidId(postId) && isValidId(userId) && isOwner(userId);
        allow list: if false;

        allow create: if isValidId(postId)
          && isValidId(userId)
          && isOwner(userId)
          && isEmailVerified()
          && isValidReaction(incoming())
          && incoming().uid == request.auth.uid
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/posts/$(postId))
          && !isBlockedBetween(get(/databases/$(database)/documents/posts/$(postId)).data.authorId, request.auth.uid);

        allow delete: if isValidId(postId)
          && isValidId(userId)
          && isOwner(userId)
          && isEmailVerified();

        allow update: if false;
      }

      // Post comments & replies subcollection
      match /comments/{commentId} {
        allow get: if isValidId(postId) && isValidId(commentId);
        allow list: if isValidId(postId);

        allow create: if isValidId(postId)
          && isValidId(commentId)
          && isEmailVerified()
          && isValidComment(incoming(), postId, commentId)
          && incoming().authorId == request.auth.uid
          && incoming().isEdited == false
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/posts/$(postId))
          && !isBlockedBetween(get(/databases/$(database)/documents/posts/$(postId)).data.authorId, request.auth.uid)
          && existsAfter(/databases/$(database)/documents/commentRateLimits/$(request.auth.uid))
          && (
            !exists(/databases/$(database)/documents/commentRateLimits/$(request.auth.uid))
            || request.time >= get(/databases/$(database)/documents/commentRateLimits/$(request.auth.uid)).data.lastCommentAt + duration.value(4, 's')
          );

        allow update: if isValidId(postId)
          && isValidId(commentId)
          && isEmailVerified()
          && isOwner(existing().authorId)
          && isValidComment(incoming(), postId, commentId)
          && incoming().id == existing().id
          && incoming().postId == existing().postId
          && incoming().authorId == existing().authorId
          && incoming().authorUsername == existing().authorUsername
          && incoming().parentCommentId == existing().parentCommentId
          && incoming().replyToAuthorUsername == existing().replyToAuthorUsername
          && incoming().createdAt == existing().createdAt
          && incoming().isEdited == true
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['content', 'hasSpoiler', 'isEdited', 'updatedAt']);

        allow delete: if isValidId(postId)
          && isValidId(commentId)
          && isEmailVerified()
          && isOwner(existing().authorId);
      }
    }

    // Build 04A: Anime Communities & Scoped Community Discussions
    match /communities/{communityId} {
      allow get: if isValidId(communityId)
        && (
          existing().status == 'active'
          || (
            isSignedIn()
            && (
              existing().ownerId == request.auth.uid
              || isCommunityMember(communityId, request.auth.uid)
            )
          )
        );

      allow list: if existing().status == 'active'
        || (isSignedIn() && existing().ownerId == request.auth.uid);

      allow create: if isValidId(communityId)
        && isEmailVerified()
        && isValidCommunity(incoming(), communityId)
        && incoming().ownerId == request.auth.uid
        && incoming().moderatorIds.size() == 1
        && incoming().moderatorIds[0] == request.auth.uid
        && incoming().memberCount == 1
        && incoming().status == 'active'
        && incoming().isFeatured == false
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/publicProfiles/$(request.auth.uid))
        && !exists(/databases/$(database)/documents/communitySlugs/$(incoming().slug))
        && existsAfter(/databases/$(database)/documents/communitySlugs/$(incoming().slug))
        && existsAfter(/databases/$(database)/documents/communityMemberships/$(communityId + '__' + request.auth.uid))
        && getAfter(/databases/$(database)/documents/communityMemberships/$(communityId + '__' + request.auth.uid)).data.role == 'owner'
        && existsAfter(/databases/$(database)/documents/communityRateLimits/$(request.auth.uid))
        && (
          !exists(/databases/$(database)/documents/communityRateLimits/$(request.auth.uid))
          || request.time >= get(/databases/$(database)/documents/communityRateLimits/$(request.auth.uid)).data.lastCreatedAt + duration.value(30, 's')
        );

      allow update: if isValidId(communityId)
        && isEmailVerified()
        && isValidCommunity(incoming(), communityId)
        && incoming().id == existing().id
        && incoming().slug == existing().slug
        && incoming().ownerId == existing().ownerId
        && incoming().isFeatured == existing().isFeatured
        && incoming().createdAt == existing().createdAt
        && (
          // Action 1: Authorized Moderator or Owner edits community details & rules
          (
            isCommunityModerator(communityId, request.auth.uid)
            && incoming().updatedAt == request.time
            && incoming().memberCount == existing().memberCount
            && incoming().visibility == existing().visibility
            && incoming().status == existing().status
            && incoming().moderatorIds == existing().moderatorIds
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'name',
              'nameLowercase',
              'description',
              'avatarUrl',
              'avatarPath',
              'coverUrl',
              'coverPath',
              'category',
              'animeTags',
              'rules',
              'updatedAt'
            ])
          )
          ||
          // Action 2: Owner updates visibility or archive/restore status
          (
            existing().ownerId == request.auth.uid
            && incoming().updatedAt == request.time
            && incoming().memberCount == existing().memberCount
            && incoming().moderatorIds == existing().moderatorIds
            && incoming().diff(existing()).affectedKeys().hasOnly(['visibility', 'status', 'updatedAt'])
          )
          ||
          // Action 3: Owner promotes or demotes moderators (synced with communityMemberships)
          (
            existing().ownerId == request.auth.uid
            && incoming().updatedAt == request.time
            && incoming().memberCount == existing().memberCount
            && incoming().ownerId in incoming().moderatorIds
            && incoming().diff(existing()).affectedKeys().hasOnly(['moderatorIds', 'updatedAt'])
          )
          ||
          // Action 4: Self join or leave on active community (memberCount +/- 1 atomically synced with own membership doc)
          (
            incoming().updatedAt == existing().updatedAt
            && incoming().diff(existing()).affectedKeys().hasOnly(['memberCount'])
            && (
              (
                existing().status == 'active'
                && existing().visibility == 'public'
                && !exists(/databases/$(database)/documents/communityMemberships/$(communityId + '__' + request.auth.uid))
                && existsAfter(/databases/$(database)/documents/communityMemberships/$(communityId + '__' + request.auth.uid))
                && incoming().memberCount == existing().memberCount + 1
              )
              ||
              (
                exists(/databases/$(database)/documents/communityMemberships/$(communityId + '__' + request.auth.uid))
                && !existsAfter(/databases/$(database)/documents/communityMemberships/$(communityId + '__' + request.auth.uid))
                && existing().memberCount >= 1
                && incoming().memberCount == existing().memberCount - 1
              )
            )
          )
          ||
          // Action 5: Moderator/Owner approves join request (+1) or removes member (-1)
          (
            isCommunityModerator(communityId, request.auth.uid)
            && incoming().updatedAt == existing().updatedAt
            && incoming().diff(existing()).affectedKeys().hasOnly(['memberCount'])
            && (
              incoming().memberCount == existing().memberCount + 1
              || (existing().memberCount >= 1 && incoming().memberCount == existing().memberCount - 1)
            )
          )
        );

      allow delete: if isValidId(communityId)
        && isEmailVerified()
        && existing().ownerId == request.auth.uid;

      // Community-scoped discussion posts (strictly member-only when private)
      match /posts/{postId} {
        allow get: if isValidId(communityId)
          && isValidId(postId)
          && canReadCommunityPosts(communityId);

        allow list: if isValidId(communityId)
          && canReadCommunityPosts(communityId);

        allow create: if isValidId(communityId)
          && isValidId(postId)
          && canParticipateInCommunity(communityId)
          && isValidPost(incoming(), postId)
          && incoming().authorId == request.auth.uid
          && incoming().likeCount == 0
          && incoming().commentCount == 0
          && incoming().isEdited == false
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/publicProfiles/$(request.auth.uid))
          && existsAfter(/databases/$(database)/documents/postRateLimits/$(request.auth.uid))
          && (
            !exists(/databases/$(database)/documents/postRateLimits/$(request.auth.uid))
            || request.time >= get(/databases/$(database)/documents/postRateLimits/$(request.auth.uid)).data.lastPostAt + duration.value(10, 's')
          );

        allow update: if isValidId(communityId)
          && isValidId(postId)
          && isEmailVerified()
          && isCommunityActive(communityId)
          && isValidPost(incoming(), postId)
          && incoming().id == existing().id
          && incoming().authorId == existing().authorId
          && incoming().authorUsername == existing().authorUsername
          && incoming().createdAt == existing().createdAt
          && (
            // Author edits own community post
            (
              isOwner(existing().authorId)
              && isCommunityMember(communityId, request.auth.uid)
              && incoming().likeCount == existing().likeCount
              && incoming().commentCount == existing().commentCount
              && incoming().isEdited == true
              && incoming().updatedAt == request.time
              && incoming().diff(existing()).affectedKeys().hasOnly(['content', 'animeTitle', 'hasSpoiler', 'spoilerLabel', 'isEdited', 'updatedAt'])
            )
            ||
            // Verified community member toggles reaction atomically
            (
              isCommunityMember(communityId, request.auth.uid)
              && !isBlockedBetween(existing().authorId, request.auth.uid)
              && incoming().updatedAt == existing().updatedAt
              && incoming().diff(existing()).affectedKeys().hasOnly(['likeCount'])
              && (
                (
                  !exists(/databases/$(database)/documents/communities/$(communityId)/posts/$(postId)/reactions/$(request.auth.uid))
                  && existsAfter(/databases/$(database)/documents/communities/$(communityId)/posts/$(postId)/reactions/$(request.auth.uid))
                  && incoming().likeCount == existing().likeCount + 1
                )
                ||
                (
                  exists(/databases/$(database)/documents/communities/$(communityId)/posts/$(postId)/reactions/$(request.auth.uid))
                  && !existsAfter(/databases/$(database)/documents/communities/$(communityId)/posts/$(postId)/reactions/$(request.auth.uid))
                  && existing().likeCount >= 1
                  && incoming().likeCount == existing().likeCount - 1
                )
              )
            )
            ||
            // Comment count sync (member adding/deleting own comment, or moderator removing comment)
            (
              (
                (isCommunityMember(communityId, request.auth.uid) && !isBlockedBetween(existing().authorId, request.auth.uid))
                || isCommunityModerator(communityId, request.auth.uid)
              )
              && incoming().updatedAt == existing().updatedAt
              && incoming().diff(existing()).affectedKeys().hasOnly(['commentCount'])
              && (
                incoming().commentCount == existing().commentCount + 1
                || (existing().commentCount >= 1 && incoming().commentCount == existing().commentCount - 1)
              )
            )
          );

        allow delete: if isValidId(communityId)
          && isValidId(postId)
          && isEmailVerified()
          && (isOwner(existing().authorId) || isCommunityModerator(communityId, request.auth.uid));

        match /reactions/{userId} {
          allow get: if isValidId(communityId) && isValidId(postId) && isValidId(userId) && isOwner(userId);
          allow list: if false;

          allow create: if isValidId(communityId)
            && isValidId(postId)
            && isValidId(userId)
            && isOwner(userId)
            && canParticipateInCommunity(communityId)
            && isValidReaction(incoming())
            && incoming().uid == request.auth.uid
            && incoming().createdAt == request.time
            && exists(/databases/$(database)/documents/communities/$(communityId)/posts/$(postId))
            && !isBlockedBetween(get(/databases/$(database)/documents/communities/$(communityId)/posts/$(postId)).data.authorId, request.auth.uid);

          allow delete: if isValidId(communityId)
            && isValidId(postId)
            && isValidId(userId)
            && isOwner(userId)
            && isEmailVerified();

          allow update: if false;
        }

        match /comments/{commentId} {
          allow get: if isValidId(communityId)
            && isValidId(postId)
            && isValidId(commentId)
            && canReadCommunityPosts(communityId);

          allow list: if isValidId(communityId)
            && isValidId(postId)
            && canReadCommunityPosts(communityId);

          allow create: if isValidId(communityId)
            && isValidId(postId)
            && isValidId(commentId)
            && canParticipateInCommunity(communityId)
            && isValidComment(incoming(), postId, commentId)
            && incoming().authorId == request.auth.uid
            && incoming().isEdited == false
            && incoming().createdAt == request.time
            && incoming().updatedAt == request.time
            && exists(/databases/$(database)/documents/communities/$(communityId)/posts/$(postId))
            && !isBlockedBetween(get(/databases/$(database)/documents/communities/$(communityId)/posts/$(postId)).data.authorId, request.auth.uid)
            && existsAfter(/databases/$(database)/documents/commentRateLimits/$(request.auth.uid))
            && (
              !exists(/databases/$(database)/documents/commentRateLimits/$(request.auth.uid))
              || request.time >= get(/databases/$(database)/documents/commentRateLimits/$(request.auth.uid)).data.lastCommentAt + duration.value(4, 's')
            );

          allow update: if isValidId(communityId)
            && isValidId(postId)
            && isValidId(commentId)
            && isEmailVerified()
            && isCommunityActive(communityId)
            && isOwner(existing().authorId)
            && isCommunityMember(communityId, request.auth.uid)
            && isValidComment(incoming(), postId, commentId)
            && incoming().id == existing().id
            && incoming().postId == existing().postId
            && incoming().authorId == existing().authorId
            && incoming().authorUsername == existing().authorUsername
            && incoming().parentCommentId == existing().parentCommentId
            && incoming().replyToAuthorUsername == existing().replyToAuthorUsername
            && incoming().createdAt == existing().createdAt
            && incoming().isEdited == true
            && incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly(['content', 'hasSpoiler', 'isEdited', 'updatedAt']);

          allow delete: if isValidId(communityId)
            && isValidId(postId)
            && isValidId(commentId)
            && isEmailVerified()
            && (isOwner(existing().authorId) || isCommunityModerator(communityId, request.auth.uid));
        }
      }
    }

    // Unique Community Slug Registry
    match /communitySlugs/{slug} {
      allow get: if isValidSlug(slug);
      allow list: if false;

      allow create: if isValidSlug(slug)
        && isEmailVerified()
        && !exists(/databases/$(database)/documents/communitySlugs/$(slug))
        && isValidCommunitySlug(incoming(), slug)
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && existsAfter(/databases/$(database)/documents/communities/$(incoming().communityId));

      allow update: if false;

      allow delete: if isValidSlug(slug)
        && isEmailVerified()
        && existing().ownerId == request.auth.uid
        && !existsAfter(/databases/$(database)/documents/communities/$(existing().communityId));
    }

    // Community Memberships ({communityId}__{userId})
    match /communityMemberships/{membershipId} {
      allow get: if isValidPairId(membershipId)
        && (
          (
            resource == null
            && isSignedIn()
            && membershipId.split('__')[1] == request.auth.uid
          )
          ||
          (
            resource != null
            && (
              (isCommunityPublic(existing().communityId) && isCommunityActive(existing().communityId))
              || (
                isSignedIn()
                && (
                  existing().userId == request.auth.uid
                  || isCommunityMember(existing().communityId, request.auth.uid)
                )
              )
            )
          )
        );

      allow list: if (isSignedIn() && existing().userId == request.auth.uid)
        || (isCommunityPublic(existing().communityId) && isCommunityActive(existing().communityId))
        || (isSignedIn() && isCommunityMember(existing().communityId, request.auth.uid));

      allow create: if isValidPairId(membershipId)
        && isEmailVerified()
        && isValidCommunityMembership(incoming(), membershipId)
        && incoming().joinedAt == request.time
        && incoming().updatedAt == request.time
        && (
          // Case 1: Community creator establishing initial owner membership atomically
          (
            incoming().userId == request.auth.uid
            && incoming().role == 'owner'
            && !exists(/databases/$(database)/documents/communities/$(incoming().communityId))
            && existsAfter(/databases/$(database)/documents/communities/$(incoming().communityId))
            && getAfter(/databases/$(database)/documents/communities/$(incoming().communityId)).data.ownerId == request.auth.uid
          )
          ||
          // Case 2: User joining an active PUBLIC community
          (
            incoming().userId == request.auth.uid
            && incoming().role == 'member'
            && isCommunityActive(incoming().communityId)
            && isCommunityPublic(incoming().communityId)
            && !exists(/databases/$(database)/documents/communityMemberships/$(membershipId))
            && getAfter(/databases/$(database)/documents/communities/$(incoming().communityId)).data.memberCount == get(/databases/$(database)/documents/communities/$(incoming().communityId)).data.memberCount + 1
          )
          ||
          // Case 3: Moderator/Owner approving a PRIVATE community join request
          (
            isCommunityModerator(incoming().communityId, request.auth.uid)
            && isCommunityActive(incoming().communityId)
            && incoming().role == 'member'
            && exists(/databases/$(database)/documents/communityJoinRequests/$(membershipId))
            && get(/databases/$(database)/documents/communityJoinRequests/$(membershipId)).data.status == 'pending'
            && getAfter(/databases/$(database)/documents/communityJoinRequests/$(membershipId)).data.status == 'approved'
            && getAfter(/databases/$(database)/documents/communities/$(incoming().communityId)).data.memberCount == get(/databases/$(database)/documents/communities/$(incoming().communityId)).data.memberCount + 1
          )
        );

      allow update: if isValidPairId(membershipId)
        && isEmailVerified()
        && isValidCommunityMembership(incoming(), membershipId)
        && incoming().id == existing().id
        && incoming().communityId == existing().communityId
        && incoming().userId == existing().userId
        && incoming().username == existing().username
        && incoming().joinedAt == existing().joinedAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Owner promotes/demotes member <-> moderator (atomically synced with community.moderatorIds)
          (
            isCommunityOwner(existing().communityId, request.auth.uid)
            && existing().userId != request.auth.uid
            && existing().role != 'owner'
            && incoming().role in ['member', 'moderator']
            && incoming().diff(existing()).affectedKeys().hasOnly(['role', 'updatedAt'])
            && (
              (incoming().role == 'moderator' && existing().userId in getAfter(/databases/$(database)/documents/communities/$(existing().communityId)).data.moderatorIds)
              || (incoming().role == 'member' && !(existing().userId in getAfter(/databases/$(database)/documents/communities/$(existing().communityId)).data.moderatorIds))
            )
          )
          ||
          // Action 2: Member refreshes own displayName/avatarUrl snapshot
          (
            existing().userId == request.auth.uid
            && incoming().role == existing().role
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'avatarUrl', 'updatedAt'])
          )
        );

      allow delete: if isValidPairId(membershipId)
        && isEmailVerified()
        && (
          // Member leaves community (owner cannot abandon without deleting community)
          (
            existing().userId == request.auth.uid
            && existing().role != 'owner'
            && !existsAfter(/databases/$(database)/documents/communityMemberships/$(membershipId))
            && (
              !existsAfter(/databases/$(database)/documents/communities/$(existing().communityId))
              || get(/databases/$(database)/documents/communities/$(existing().communityId)).data.memberCount == 0
              || getAfter(/databases/$(database)/documents/communities/$(existing().communityId)).data.memberCount == get(/databases/$(database)/documents/communities/$(existing().communityId)).data.memberCount - 1
            )
          )
          ||
          // Owner deleting entire community cleans up own membership atomically
          (
            existing().userId == request.auth.uid
            && existing().role == 'owner'
            && !existsAfter(/databases/$(database)/documents/communities/$(existing().communityId))
          )
          ||
          // Moderator removes standard member, or Owner removes any non-owner member
          (
            isCommunityModerator(existing().communityId, request.auth.uid)
            && existing().role != 'owner'
            && (existing().role == 'member' || isCommunityOwner(existing().communityId, request.auth.uid))
            && (
              !existsAfter(/databases/$(database)/documents/communities/$(existing().communityId))
              || get(/databases/$(database)/documents/communities/$(existing().communityId)).data.memberCount == 0
              || getAfter(/databases/$(database)/documents/communities/$(existing().communityId)).data.memberCount == get(/databases/$(database)/documents/communities/$(existing().communityId)).data.memberCount - 1
            )
          )
        );
    }

    // Private Community Join Requests ({communityId}__{userId})
    match /communityJoinRequests/{requestId} {
      allow get: if isValidPairId(requestId)
        && isSignedIn()
        && (
          (resource == null && requestId.split('__')[1] == request.auth.uid)
          || (
            resource != null
            && (
              existing().userId == request.auth.uid
              || isCommunityModerator(existing().communityId, request.auth.uid)
            )
          )
        );

      allow list: if isSignedIn()
        && (
          existing().userId == request.auth.uid
          || isCommunityModerator(existing().communityId, request.auth.uid)
        );

      allow create: if isValidPairId(requestId)
        && isEmailVerified()
        && isValidCommunityJoinRequest(incoming(), requestId)
        && incoming().userId == request.auth.uid
        && incoming().status == 'pending'
        && incoming().reviewedBy == ''
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isCommunityActive(incoming().communityId)
        && !isCommunityPublic(incoming().communityId)
        && !isCommunityMember(incoming().communityId, request.auth.uid);

      allow update: if isValidPairId(requestId)
        && isEmailVerified()
        && isValidCommunityJoinRequest(incoming(), requestId)
        && incoming().id == existing().id
        && incoming().communityId == existing().communityId
        && incoming().userId == existing().userId
        && incoming().username == existing().username
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Moderator/Owner approves or rejects pending request
          (
            isCommunityModerator(existing().communityId, request.auth.uid)
            && existing().status == 'pending'
            && incoming().status in ['approved', 'rejected']
            && incoming().reviewedBy == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'reviewedBy', 'updatedAt'])
            && (
              incoming().status == 'rejected'
              || existsAfter(/databases/$(database)/documents/communityMemberships/$(existing().communityId + '__' + existing().userId))
            )
          )
          ||
          // Requester re-submits after a previous rejection or after leaving the community
          (
            existing().userId == request.auth.uid
            && existing().status in ['rejected', 'approved']
            && incoming().status == 'pending'
            && incoming().reviewedBy == ''
            && isCommunityActive(existing().communityId)
            && !isCommunityPublic(existing().communityId)
            && !isCommunityMember(existing().communityId, request.auth.uid)
            && incoming().diff(existing()).affectedKeys().hasOnly(['message', 'status', 'reviewedBy', 'updatedAt'])
          )
        );

      allow delete: if isValidPairId(requestId)
        && isEmailVerified()
        && (
          (existing().userId == request.auth.uid && existing().status == 'pending')
          || isCommunityOwner(existing().communityId, request.auth.uid)
        );
    }

    // Per-user server-timestamp rate limits for community creation
    match /communityRateLimits/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create, update: if isValidId(userId)
        && isOwner(userId)
        && isEmailVerified()
        && incoming().keys().hasAll(['uid', 'lastCreatedAt'])
        && incoming().keys().hasOnly(['uid', 'lastCreatedAt'])
        && incoming().uid == userId
        && incoming().lastCreatedAt == request.time;

      allow delete: if false;
    }

    // Deterministic Follow Relationships ({followerId}__{followingId})
    match /follows/{followId} {
      allow get: if isValidPairId(followId)
        && isSignedIn()
        && (resource == null || existing().followerId == request.auth.uid || existing().followingId == request.auth.uid);

      allow list: if isSignedIn()
        && (existing().followerId == request.auth.uid || existing().followingId == request.auth.uid);

      allow create: if isValidPairId(followId)
        && isEmailVerified()
        && isValidFollow(incoming(), followId)
        && incoming().followerId == request.auth.uid
        && incoming().createdAt == request.time
        && exists(/databases/$(database)/documents/publicProfiles/$(incoming().followingId))
        && !isBlockedBetween(request.auth.uid, incoming().followingId);

      allow delete: if isValidPairId(followId)
        && isEmailVerified()
        && existing().followerId == request.auth.uid;

      allow update: if false;
    }

    // Deterministic Block Relationships ({blockerId}__{blockedId})
    match /blocks/{blockId} {
      allow get: if isValidPairId(blockId)
        && isSignedIn()
        && (resource == null || existing().blockerId == request.auth.uid || existing().blockedId == request.auth.uid);

      allow list: if isSignedIn()
        && existing().blockerId == request.auth.uid;

      allow create: if isValidPairId(blockId)
        && isEmailVerified()
        && isValidBlock(incoming(), blockId)
        && incoming().blockerId == request.auth.uid
        && incoming().createdAt == request.time;

      allow delete: if isValidPairId(blockId)
        && isEmailVerified()
        && existing().blockerId == request.auth.uid;

      allow update: if false;
    }

    // Private Moderation Reports (never publicly readable)
    match /reports/{reportId} {
      allow read: if false;

      allow create: if isValidId(reportId)
        && isEmailVerified()
        && isValidReport(incoming(), reportId)
        && incoming().reporterId == request.auth.uid
        && incoming().createdAt == request.time;

      allow update, delete: if false;
    }

    // Per-user server-timestamp rate limits
    match /postRateLimits/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create, update: if isValidId(userId)
        && isOwner(userId)
        && isEmailVerified()
        && incoming().keys().hasAll(['uid', 'lastPostAt'])
        && incoming().keys().hasOnly(['uid', 'lastPostAt'])
        && incoming().uid == userId
        && incoming().lastPostAt == request.time;

      allow delete: if false;
    }

    match /commentRateLimits/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create, update: if isValidId(userId)
        && isOwner(userId)
        && isEmailVerified()
        && incoming().keys().hasAll(['uid', 'lastCommentAt'])
        && incoming().keys().hasOnly(['uid', 'lastCommentAt'])
        && incoming().uid == userId
        && incoming().lastCommentAt == request.time;

      allow delete: if false;
    }

    // Build 04B: Per-user Private Messaging Settings
    match /messageSettings/{userId} {
      allow get: if isValidId(userId) && isSignedIn();
      allow list: if false;

      allow create, update: if isValidId(userId)
        && isOwner(userId)
        && isEmailVerified()
        && isValidMessageSettings(incoming(), userId)
        && incoming().updatedAt == request.time;

      allow delete: if false;
    }

    // Build 04B: Conservative Last-Active / Visibility-Gated Presence Foundation
    match /userPresence/{userId} {
      allow get: if isValidId(userId)
        && isSignedIn()
        && (
          resource == null
          || isOwner(userId)
          || (!isBlockedBetween(userId, request.auth.uid) && existing().visible == true)
        );
      allow list: if false;

      allow create, update: if isValidId(userId)
        && isOwner(userId)
        && isEmailVerified()
        && isValidUserPresence(incoming(), userId)
        && incoming().lastActiveAt == request.time
        && incoming().updatedAt == request.time;

      allow delete: if false;
    }

    // Build 04B: Private Direct & Group Conversations
    match /conversations/{conversationId} {
      allow get: if isValidConversationId(conversationId)
        && isSignedIn()
        && (
          (
            resource == null
            && (
              conversationId.matches('^dm__' + request.auth.uid + '__[a-zA-Z0-9_\\-]+$')
              || conversationId.matches('^dm__[a-zA-Z0-9_\\-]+__' + request.auth.uid + '$')
            )
          )
          || (resource != null && request.auth.uid in existing().participantIds)
        );

      allow list: if isSignedIn()
        && request.auth.uid in existing().participantIds;

      allow create: if isValidConversationId(conversationId)
        && isEmailVerified()
        && isValidConversation(incoming(), conversationId)
        && incoming().status == 'active'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && incoming().lastMessageAt == request.time
        && (
          // Direct conversation created atomically when recipient accepts a pending message request
          (
            incoming().type == 'direct'
            && incoming().participantIds.size() == 2
            && request.auth.uid in incoming().participantIds
            && (
              (
                incoming().participantIds[0] == request.auth.uid
                && conversationId == 'dm__' + (incoming().participantIds[1] < request.auth.uid ? incoming().participantIds[1] + '__' + request.auth.uid : request.auth.uid + '__' + incoming().participantIds[1])
                && incoming().directKey == (incoming().participantIds[1] < request.auth.uid ? incoming().participantIds[1] + '__' + request.auth.uid : request.auth.uid + '__' + incoming().participantIds[1])
                && !isBlockedBetween(request.auth.uid, incoming().participantIds[1])
                && exists(/databases/$(database)/documents/messageRequests/$(incoming().participantIds[1] + '__' + request.auth.uid))
                && get(/databases/$(database)/documents/messageRequests/$(incoming().participantIds[1] + '__' + request.auth.uid)).data.status == 'pending'
                && getAfter(/databases/$(database)/documents/messageRequests/$(incoming().participantIds[1] + '__' + request.auth.uid)).data.status == 'accepted'
              )
              ||
              (
                incoming().participantIds[1] == request.auth.uid
                && conversationId == 'dm__' + (incoming().participantIds[0] < request.auth.uid ? incoming().participantIds[0] + '__' + request.auth.uid : request.auth.uid + '__' + incoming().participantIds[0])
                && incoming().directKey == (incoming().participantIds[0] < request.auth.uid ? incoming().participantIds[0] + '__' + request.auth.uid : request.auth.uid + '__' + incoming().participantIds[0])
                && !isBlockedBetween(request.auth.uid, incoming().participantIds[0])
                && exists(/databases/$(database)/documents/messageRequests/$(incoming().participantIds[0] + '__' + request.auth.uid))
                && get(/databases/$(database)/documents/messageRequests/$(incoming().participantIds[0] + '__' + request.auth.uid)).data.status == 'pending'
                && getAfter(/databases/$(database)/documents/messageRequests/$(incoming().participantIds[0] + '__' + request.auth.uid)).data.status == 'accepted'
              )
            )
            && existsAfter(/databases/$(database)/documents/conversationMembers/$(conversationId + '__' + incoming().participantIds[0]))
            && existsAfter(/databases/$(database)/documents/conversationMembers/$(conversationId + '__' + incoming().participantIds[1]))
          )
          ||
          // Group conversation created by verified owner with atomic rate limit & owner membership
          (
            incoming().type == 'group'
            && incoming().ownerId == request.auth.uid
            && incoming().adminIds.size() == 1
            && incoming().adminIds[0] == request.auth.uid
            && incoming().participantIds.size() >= 2
            && request.auth.uid in incoming().participantIds
            && exists(/databases/$(database)/documents/publicProfiles/$(request.auth.uid))
            && existsAfter(/databases/$(database)/documents/conversationMembers/$(conversationId + '__' + request.auth.uid))
            && getAfter(/databases/$(database)/documents/conversationMembers/$(conversationId + '__' + request.auth.uid)).data.role == 'owner'
            && getAfter(/databases/$(database)/documents/messageRateLimits/$(request.auth.uid)).data.lastGroupCreatedAt == request.time
            && (
              !exists(/databases/$(database)/documents/messageRateLimits/$(request.auth.uid))
              || get(/databases/$(database)/documents/messageRateLimits/$(request.auth.uid)).data.lastGroupCreatedAt == null
              || request.time >= get(/databases/$(database)/documents/messageRateLimits/$(request.auth.uid)).data.lastGroupCreatedAt + duration.value(20, 's')
            )
          )
        );

      allow update: if isValidConversationId(conversationId)
        && isEmailVerified()
        && request.auth.uid in existing().participantIds
        && isValidConversation(incoming(), conversationId)
        && incoming().id == existing().id
        && incoming().type == existing().type
        && incoming().directKey == existing().directKey
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Active participant updates last-message summary on send/edit/delete
          (
            existing().status == 'active'
            && incoming().status == existing().status
            && incoming().participantIds == existing().participantIds
            && incoming().adminIds == existing().adminIds
            && (existing().type == 'group' || !isBlockedBetween(existing().participantIds[0], existing().participantIds[1]))
            && (incoming().lastMessageAt == request.time || incoming().lastMessageAt == existing().lastMessageAt)
            && incoming().diff(existing()).affectedKeys().hasOnly(['lastMessageText', 'lastMessageSenderId', 'lastMessageType', 'lastMessageAt', 'updatedAt'])
          )
          ||
          // Action 2: Group owner/admin updates group name, description, or avatar
          (
            existing().type == 'group'
            && existing().status == 'active'
            && request.auth.uid in existing().adminIds
            && incoming().participantIds == existing().participantIds
            && incoming().adminIds == existing().adminIds
            && incoming().status == existing().status
            && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'avatarUrl', 'avatarPath', 'updatedAt'])
          )
          ||
          // Action 3: Group owner archives or restores group
          (
            existing().type == 'group'
            && existing().ownerId == request.auth.uid
            && incoming().participantIds == existing().participantIds
            && incoming().adminIds == existing().adminIds
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
          ||
          // Action 4: Group owner promotes/demotes admins (only from existing participants)
          (
            existing().type == 'group'
            && existing().status == 'active'
            && existing().ownerId == request.auth.uid
            && incoming().participantIds == existing().participantIds
            && incoming().ownerId in incoming().adminIds
            && incoming().participantIds.hasAll(incoming().adminIds)
            && incoming().diff(existing()).affectedKeys().hasOnly(['adminIds', 'updatedAt'])
          )
          ||
          // Action 5: Group admin adds or removes members (owner cannot be removed)
          (
            existing().type == 'group'
            && existing().status == 'active'
            && request.auth.uid in existing().adminIds
            && existing().ownerId in incoming().participantIds
            && existing().ownerId in incoming().adminIds
            && incoming().participantIds.hasAll(incoming().adminIds)
            && (incoming().lastMessageAt == request.time || incoming().lastMessageAt == existing().lastMessageAt)
            && incoming().diff(existing()).affectedKeys().hasOnly(['participantIds', 'adminIds', 'lastMessageText', 'lastMessageSenderId', 'lastMessageType', 'lastMessageAt', 'updatedAt'])
          )
          ||
          // Action 6: Non-owner participant leaves group cleanly
          (
            existing().type == 'group'
            && existing().status == 'active'
            && existing().ownerId != request.auth.uid
            && !(request.auth.uid in incoming().participantIds)
            && !(request.auth.uid in incoming().adminIds)
            && existing().participantIds.hasAll(incoming().participantIds)
            && incoming().participantIds.size() == existing().participantIds.size() - 1
            && incoming().participantIds.hasAll(incoming().adminIds)
            && (incoming().lastMessageAt == request.time || incoming().lastMessageAt == existing().lastMessageAt)
            && incoming().diff(existing()).affectedKeys().hasOnly(['participantIds', 'adminIds', 'lastMessageText', 'lastMessageSenderId', 'lastMessageType', 'lastMessageAt', 'updatedAt'])
          )
        );

      allow delete: if isValidConversationId(conversationId)
        && isEmailVerified()
        && existing().type == 'group'
        && existing().ownerId == request.auth.uid;

      // Real-time messages inside a private conversation
      match /messages/{messageId} {
        allow get: if isValidConversationId(conversationId)
          && isValidId(messageId)
          && isSignedIn()
          && isConversationParticipant(conversationId, request.auth.uid);

        allow list: if isValidConversationId(conversationId)
          && isSignedIn()
          && isConversationParticipant(conversationId, request.auth.uid);

        allow create: if isValidConversationId(conversationId)
          && isValidId(messageId)
          && isEmailVerified()
          && isValidMessage(incoming(), conversationId, messageId)
          && incoming().editedAt == null
          && incoming().deletedAt == null
          && incoming().createdAt == request.time
          && (
            // Standard message inside an existing active conversation
            (
              isConversationParticipant(conversationId, request.auth.uid)
              && isConversationActive(conversationId)
              && incoming().senderId == request.auth.uid
              && (
                get(/databases/$(database)/documents/conversations/$(conversationId)).data.type == 'group'
                || !isBlockedBetween(
                  get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds[0],
                  get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds[1]
                )
              )
              && (
                incoming().messageType == 'system'
                || (
                  getAfter(/databases/$(database)/documents/messageRateLimits/$(request.auth.uid)).data.lastMessageAt == request.time
                  && (
                    !exists(/databases/$(database)/documents/messageRateLimits/$(request.auth.uid))
                    || get(/databases/$(database)/documents/messageRateLimits/$(request.auth.uid)).data.lastMessageAt == null
                    || request.time >= get(/databases/$(database)/documents/messageRateLimits/$(request.auth.uid)).data.lastMessageAt + duration.value(1, 's')
                  )
                )
              )
            )
            ||
            // Initial system message written atomically during group conversation creation
            (
              !exists(/databases/$(database)/documents/conversations/$(conversationId))
              && existsAfter(/databases/$(database)/documents/conversations/$(conversationId))
              && getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.type == 'group'
              && getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.ownerId == request.auth.uid
              && incoming().senderId == request.auth.uid
              && incoming().messageType == 'system'
            )
            ||
            // Initial text message preserved atomically when recipient accepts a pending message request
            (
              !exists(/databases/$(database)/documents/conversations/$(conversationId))
              && existsAfter(/databases/$(database)/documents/conversations/$(conversationId))
              && getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.type == 'direct'
              && incoming().messageType == 'text'
              && incoming().senderId != request.auth.uid
              && incoming().senderId in getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds
              && request.auth.uid in getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds
              && exists(/databases/$(database)/documents/messageRequests/$(incoming().senderId + '__' + request.auth.uid))
              && get(/databases/$(database)/documents/messageRequests/$(incoming().senderId + '__' + request.auth.uid)).data.status == 'pending'
              && getAfter(/databases/$(database)/documents/messageRequests/$(incoming().senderId + '__' + request.auth.uid)).data.status == 'accepted'
              && incoming().text == get(/databases/$(database)/documents/messageRequests/$(incoming().senderId + '__' + request.auth.uid)).data.initialMessage
            )
          );

        allow update: if isValidConversationId(conversationId)
          && isValidId(messageId)
          && isEmailVerified()
          && isConversationParticipant(conversationId, request.auth.uid)
          && isConversationActive(conversationId)
          && isValidMessage(incoming(), conversationId, messageId)
          && existing().senderId == request.auth.uid
          && existing().deletedAt == null
          && existing().messageType == 'text'
          && incoming().id == existing().id
          && incoming().conversationId == existing().conversationId
          && incoming().senderId == existing().senderId
          && incoming().senderUsername == existing().senderUsername
          && incoming().messageType == existing().messageType
          && incoming().replyToMessageId == existing().replyToMessageId
          && incoming().replyToPreview == existing().replyToPreview
          && incoming().replyToSenderName == existing().replyToSenderName
          && incoming().createdAt == existing().createdAt
          && (
            // Edit own text message within 15 minutes
            (
              incoming().deletedAt == null
              && incoming().editedAt == request.time
              && incoming().text.size() >= 1
              && request.time <= existing().createdAt + duration.value(15, 'm')
              && incoming().diff(existing()).affectedKeys().hasOnly(['text', 'editedAt'])
            )
            ||
            // Soft-delete / tombstone own message
            (
              incoming().deletedAt == request.time
              && incoming().text == ''
              && incoming().editedAt == existing().editedAt
              && incoming().diff(existing()).affectedKeys().hasOnly(['text', 'deletedAt'])
            )
          );

        allow delete: if false;
      }

      // Ephemeral per-user typing indicator state
      match /typing/{userId} {
        allow get: if isValidConversationId(conversationId)
          && isValidId(userId)
          && isSignedIn()
          && isConversationParticipant(conversationId, request.auth.uid);

        allow list: if isValidConversationId(conversationId)
          && isSignedIn()
          && isConversationParticipant(conversationId, request.auth.uid);

        allow create, update: if isValidConversationId(conversationId)
          && isValidId(userId)
          && isOwner(userId)
          && isEmailVerified()
          && isConversationParticipant(conversationId, request.auth.uid)
          && isConversationActive(conversationId)
          && isValidTypingDoc(incoming(), userId)
          && incoming().updatedAt == request.time;

        allow delete: if isValidConversationId(conversationId)
          && isValidId(userId)
          && isOwner(userId)
          && isEmailVerified();
      }
    }

    // Build 04B: Deterministic Per-Member Conversation State ({conversationId}__{userId})
    match /conversationMembers/{memberDocId} {
      allow get: if isValidMemberDocId(memberDocId)
        && isSignedIn()
        && (
          (resource == null && memberDocId.matches('^[a-zA-Z0-9_\\-]+__' + request.auth.uid + '$'))
          || (
            resource != null
            && (
              existing().userId == request.auth.uid
              || isConversationParticipant(existing().conversationId, request.auth.uid)
            )
          )
        );

      allow list: if isSignedIn()
        && (
          existing().userId == request.auth.uid
          || isConversationParticipant(existing().conversationId, request.auth.uid)
        );

      allow create: if isValidMemberDocId(memberDocId)
        && isEmailVerified()
        && isValidConversationMember(incoming(), memberDocId)
        && incoming().unreadCount >= 0
        && incoming().muted == false
        && incoming().archived == false
        && incoming().joinedAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/publicProfiles/$(incoming().userId))
        && (incoming().userId == request.auth.uid || !isBlockedBetween(request.auth.uid, incoming().userId))
        && (
          // Atomic direct conversation accept or group creation
          (
            !exists(/databases/$(database)/documents/conversations/$(incoming().conversationId))
            && existsAfter(/databases/$(database)/documents/conversations/$(incoming().conversationId))
            && incoming().userId in getAfter(/databases/$(database)/documents/conversations/$(incoming().conversationId)).data.participantIds
            && (
              (
                getAfter(/databases/$(database)/documents/conversations/$(incoming().conversationId)).data.type == 'direct'
                && incoming().role == 'member'
              )
              ||
              (
                getAfter(/databases/$(database)/documents/conversations/$(incoming().conversationId)).data.type == 'group'
                && getAfter(/databases/$(database)/documents/conversations/$(incoming().conversationId)).data.ownerId == request.auth.uid
                && (
                  (incoming().userId == request.auth.uid && incoming().role == 'owner')
                  || (incoming().userId != request.auth.uid && incoming().role == 'member')
                )
              )
            )
          )
          ||
          // Existing group admin adds a new member atomically
          (
            isConversationAdmin(incoming().conversationId, request.auth.uid)
            && isConversationActive(incoming().conversationId)
            && incoming().role == 'member'
            && incoming().userId in getAfter(/databases/$(database)/documents/conversations/$(incoming().conversationId)).data.participantIds
          )
        );

      allow update: if isValidMemberDocId(memberDocId)
        && isEmailVerified()
        && isValidConversationMember(incoming(), memberDocId)
        && incoming().id == existing().id
        && incoming().conversationId == existing().conversationId
        && incoming().userId == existing().userId
        && incoming().username == existing().username
        && incoming().joinedAt == existing().joinedAt
        && incoming().updatedAt == request.time
        && (
          // Member updates own read cursor, unread clear, mute, archive, or profile snapshot
          (
            existing().userId == request.auth.uid
            && isConversationParticipant(existing().conversationId, request.auth.uid)
            && incoming().role == existing().role
            && (incoming().unreadCount == 0 || incoming().unreadCount == existing().unreadCount)
            && incoming().diff(existing()).affectedKeys().hasOnly(['unreadCount', 'lastReadAt', 'muted', 'archived', 'displayName', 'avatarUrl', 'updatedAt'])
          )
          ||
          // Another active participant increments unreadCount by +1 on message send
          (
            existing().userId != request.auth.uid
            && isConversationParticipant(existing().conversationId, request.auth.uid)
            && existing().userId in get(/databases/$(database)/documents/conversations/$(existing().conversationId)).data.participantIds
            && incoming().unreadCount == existing().unreadCount + 1
            && incoming().diff(existing()).affectedKeys().hasOnly(['unreadCount', 'updatedAt'])
          )
          ||
          // Group owner promotes/demotes member <-> admin (synced with conversation.adminIds)
          (
            isConversationOwner(existing().conversationId, request.auth.uid)
            && existing().userId != request.auth.uid
            && existing().role != 'owner'
            && incoming().role in ['member', 'admin']
            && incoming().diff(existing()).affectedKeys().hasOnly(['role', 'updatedAt'])
            && (
              (incoming().role == 'admin' && existing().userId in getAfter(/databases/$(database)/documents/conversations/$(existing().conversationId)).data.adminIds)
              || (incoming().role == 'member' && !(existing().userId in getAfter(/databases/$(database)/documents/conversations/$(existing().conversationId)).data.adminIds))
            )
          )
        );

      allow delete: if isValidMemberDocId(memberDocId)
        && isEmailVerified()
        && (
          // Member leaves group atomically
          (
            existing().userId == request.auth.uid
            && existing().role != 'owner'
            && existsAfter(/databases/$(database)/documents/conversations/$(existing().conversationId))
            && !(request.auth.uid in getAfter(/databases/$(database)/documents/conversations/$(existing().conversationId)).data.participantIds)
          )
          ||
          // Group admin removes non-owner member (or owner removes admin) atomically
          (
            isConversationAdmin(existing().conversationId, request.auth.uid)
            && existing().role != 'owner'
            && (existing().role == 'member' || isConversationOwner(existing().conversationId, request.auth.uid))
            && existsAfter(/databases/$(database)/documents/conversations/$(existing().conversationId))
            && !(existing().userId in getAfter(/databases/$(database)/documents/conversations/$(existing().conversationId)).data.participantIds)
          )
          ||
          // Group owner deleting entire group cleans up memberships atomically
          (
            isConversationOwner(existing().conversationId, request.auth.uid)
            && !existsAfter(/databases/$(database)/documents/conversations/$(existing().conversationId))
          )
        );
    }

    // Build 04B: First-Contact Message Requests ({senderId}__{recipientId})
    match /messageRequests/{requestId} {
      allow get: if isValidPairId(requestId)
        && isSignedIn()
        && (
          (
            resource == null
            && (
              requestId.matches('^' + request.auth.uid + '__[a-zA-Z0-9_\\-]+$')
              || requestId.matches('^[a-zA-Z0-9_\\-]+__' + request.auth.uid + '$')
            )
          )
          || (
            resource != null
            && (existing().senderId == request.auth.uid || existing().recipientId == request.auth.uid)
          )
        );

      allow list: if isSignedIn()
        && (existing().senderId == request.auth.uid || existing().recipientId == request.auth.uid);

      allow create: if isValidPairId(requestId)
        && isEmailVerified()
        && isValidMessageRequest(incoming(), requestId)
        && incoming().senderId == request.auth.uid
        && incoming().status == 'pending'
        && incoming().conversationId == ''
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && recipientAllowsMessageRequest(request.auth.uid, incoming().recipientId)
        && !exists(/databases/$(database)/documents/conversations/$(directConvId(request.auth.uid, incoming().recipientId)))
        && getAfter(/databases/$(database)/documents/messageRateLimits/$(request.auth.uid)).data.lastRequestAt == request.time
        && (
          !exists(/databases/$(database)/documents/messageRateLimits/$(request.auth.uid))
          || get(/databases/$(database)/documents/messageRateLimits/$(request.auth.uid)).data.lastRequestAt == null
          || request.time >= get(/databases/$(database)/documents/messageRateLimits/$(request.auth.uid)).data.lastRequestAt + duration.value(10, 's')
        );

      allow update: if isValidPairId(requestId)
        && isEmailVerified()
        && isValidMessageRequest(incoming(), requestId)
        && incoming().id == existing().id
        && incoming().senderId == existing().senderId
        && incoming().recipientId == existing().recipientId
        && incoming().senderUsername == existing().senderUsername
        && incoming().recipientUsername == existing().recipientUsername
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Recipient accepts pending request atomically with direct conversation creation
          (
            existing().recipientId == request.auth.uid
            && existing().status == 'pending'
            && incoming().status == 'accepted'
            && !isBlockedBetween(existing().senderId, existing().recipientId)
            && isValidConversationId(incoming().conversationId)
            && existsAfter(/databases/$(database)/documents/conversations/$(incoming().conversationId))
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'conversationId', 'updatedAt'])
          )
          ||
          // Recipient declines pending request (permanent decline prevents repeat spam)
          (
            existing().recipientId == request.auth.uid
            && existing().status == 'pending'
            && incoming().status == 'declined'
            && incoming().conversationId == ''
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
          ||
          // Sender cancels own pending request
          (
            existing().senderId == request.auth.uid
            && existing().status == 'pending'
            && incoming().status == 'cancelled'
            && incoming().conversationId == ''
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
          ||
          // Sender may re-send ONLY if previously cancelled (never after declined)
          (
            existing().senderId == request.auth.uid
            && existing().status == 'cancelled'
            && incoming().status == 'pending'
            && incoming().conversationId == ''
            && recipientAllowsMessageRequest(request.auth.uid, existing().recipientId)
            && !exists(/databases/$(database)/documents/conversations/$(directConvId(request.auth.uid, existing().recipientId)))
            && incoming().diff(existing()).affectedKeys().hasOnly(['initialMessage', 'status', 'senderDisplayName', 'senderAvatarUrl', 'updatedAt'])
          )
        );

      allow delete: if isValidPairId(requestId)
        && isEmailVerified()
        && existing().senderId == request.auth.uid
        && existing().status == 'cancelled';
    }

    // Build 04B: Per-user server-timestamp messaging rate limits
    match /messageRateLimits/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isValidId(userId)
        && isOwner(userId)
        && isEmailVerified()
        && isValidMessageRateLimit(incoming(), userId)
        && (incoming().lastMessageAt == null || incoming().lastMessageAt == request.time)
        && (incoming().lastRequestAt == null || incoming().lastRequestAt == request.time)
        && (incoming().lastGroupCreatedAt == null || incoming().lastGroupCreatedAt == request.time);

      allow update: if isValidId(userId)
        && isOwner(userId)
        && isEmailVerified()
        && isValidMessageRateLimit(incoming(), userId)
        && (incoming().lastMessageAt == existing().lastMessageAt || incoming().lastMessageAt == request.time)
        && (incoming().lastRequestAt == existing().lastRequestAt || incoming().lastRequestAt == request.time)
        && (incoming().lastGroupCreatedAt == existing().lastGroupCreatedAt || incoming().lastGroupCreatedAt == request.time);

      allow delete: if false;
    }

    // Build 05: Notifications (trusted Cloud Functions Admin SDK creation only)
    match /notifications/{notificationId} {
      allow get: if isValidNotificationId(notificationId)
        && isSignedIn()
        && resource != null
        && existing().recipientId == request.auth.uid;

      allow list: if isSignedIn()
        && existing().recipientId == request.auth.uid;

      allow create: if false;

      allow update: if isValidNotificationId(notificationId)
        && isSignedIn()
        && resource != null
        && existing().recipientId == request.auth.uid
        && isValidNotificationUpdate(incoming(), existing());

      allow delete: if isValidNotificationId(notificationId)
        && isSignedIn()
        && resource != null
        && existing().recipientId == request.auth.uid
        && existing().isDismissed == true;
    }

    // Build 05: Notification Settings
    match /notificationSettings/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create, update: if isValidId(userId)
        && isOwner(userId)
        && isEmailVerified()
        && isValidNotificationSettings(incoming(), userId);
      allow delete: if false;
    }

    // Build 06: User Preferences
    match /userPreferences/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create, update: if isValidId(userId)
        && isOwner(userId);
      allow delete: if false;
    }

    // Build 06: User Anime Lists (Tracker)
    match /userAnimeLists/{userId}/items/{itemId} {
      allow get, list: if isValidId(userId) && isOwner(userId);
      allow create, update, delete: if isValidId(userId)
        && isOwner(userId);
    }

    // Build 07A: User Watch Reminders
    match /userReminders/{userId}/items/{itemId} {
      allow get, list: if isValidId(userId) && isOwner(userId);
      allow create, update, delete: if isValidId(userId)
        && isOwner(userId);
    }

    // Build 07A: User News Bookmarks
    match /userNewsBookmarks/{userId}/items/{itemId} {
      allow get, list: if isValidId(userId) && isOwner(userId);
      allow create, update, delete: if isValidId(userId)
        && isOwner(userId);
    }

    // Build 06: User Collections
    match /userCollections/{collectionId} {
      allow get: if resource != null
        && (resource.data.visibility == 'public' || (isSignedIn() && resource.data.ownerId == request.auth.uid));
      allow list: if true;
      allow create: if isSignedIn()
        && incoming().ownerId == request.auth.uid;
      allow update, delete: if isSignedIn()
        && existing().ownerId == request.auth.uid;
    }

    // Build 06: Recommendation Feedback
    match /recommendationFeedback/{userId}/items/{itemId} {
      allow get, list: if isValidId(userId) && isOwner(userId);
      allow create, update, delete: if isValidId(userId)
        && isOwner(userId);
    }
  }
}
