{
  "entities": {
    "UserPrivateAccount": {
      "title": "UserPrivateAccount",
      "description": "Private ATA member account record containing protected email and verification state. Readable only by the authenticated owner.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "username": {
          "type": "string",
          "minLength": 3,
          "maxLength": 20,
          "pattern": "^[a-zA-Z0-9_]{3,20}$"
        },
        "usernameLowercase": {
          "type": "string",
          "minLength": 3,
          "maxLength": 20,
          "pattern": "^[a-z0-9_]{3,20}$"
        },
        "displayName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 5,
          "maxLength": 254
        },
        "bio": {
          "type": "string",
          "minLength": 0,
          "maxLength": 280
        },
        "avatarUrl": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500
        },
        "emailVerified": {
          "type": "boolean"
        },
        "accountStatus": {
          "type": "string",
          "enum": ["pending_verification", "active"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "username",
        "usernameLowercase",
        "displayName",
        "email",
        "bio",
        "avatarUrl",
        "emailVerified",
        "accountStatus",
        "createdAt",
        "updatedAt"
      ]
    },
    "PublicProfile": {
      "title": "PublicProfile",
      "description": "Non-PII public ATA member profile containing zero private email or status fields.",
