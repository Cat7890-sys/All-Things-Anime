          "type": "string",
          "minLength": 0,
          "maxLength": 280
        },
        "avatarUrl": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500
        },
        "followersCount": {
          "type": "integer"
        },
        "followingCount": {
          "type": "integer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "username",
        "usernameLowercase",
        "displayName",
        "bio",
        "avatarUrl",
        "createdAt",
        "updatedAt"
      ]
    },
    "UsernameReservation": {
