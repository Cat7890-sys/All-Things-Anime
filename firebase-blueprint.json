    "/messageRequests/{requestId}": {
      "schema": {
        "$ref": "#/entities/MessageRequest"
      },
      "description": "Private first-contact message requests keyed by {senderId}__{recipientId}."
    },
    "/messageRateLimits/{userId}": {
      "schema": {
        "$ref": "#/entities/MessageRateLimit"
      },
      "description": "Server-time rate limiting checkpoints for messaging actions."
    },
    "/notifications/{notificationId}": {
      "schema": {
        "$ref": "#/entities/Notification"
      },
      "description": "Server-generated real-time notifications accessible strictly to the recipient."
    },
    "/notificationSettings/{userId}": {
      "schema": {
        "$ref": "#/entities/NotificationSettings"
      },
      "description": "Owner-only notification category, toast, and quiet-hours preferences."
    }
  }
