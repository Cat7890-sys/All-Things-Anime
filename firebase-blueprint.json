          "minLength": 3,
          "maxLength": 20,
          "pattern": "^[a-z0-9_]{3,20}$"
        },
        "displayName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 5,
          "maxLength": 254
        },
        "bio": {
          "type": "string",
          "minLength": 0,
          "maxLength": 280
        },
        "avatarUrl": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500
        },
        "emailVerified": {
          "type": "boolean"
        },
        "accountStatus": {
          "type": "string",
          "enum": ["pending_verification", "active"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "username",
        "usernameLowercase",
        "displayName",
        "email",
        "bio",
        "avatarUrl",
        "emailVerified",
        "accountStatus",
        "createdAt",
        "updatedAt"
      ]
    },
