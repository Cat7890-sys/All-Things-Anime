  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserPrivateAccount"
      },
      "description": "Owner-only private user account records containing email and verification state."
    },
    "/publicProfiles/{userId}": {
      "schema": {
        "$ref": "#/entities/PublicProfile"
      },
      "description": "Publicly readable non-PII user profiles with follower/following counters."
    },
    "/usernames/{usernameLowercase}": {
      "schema": {
        "$ref": "#/entities/UsernameReservation"
      },
      "description": "Unique username registry preventing duplicate handle claims."
    },
    "/posts/{postId}": {
      "schema": {
        "$ref": "#/entities/Post"
      },
      "description": "Global community feed posts."
    },
    "/posts/{postId}/reactions/{userId}": {
      "schema": {
        "$ref": "#/entities/PostReaction"
      },
      "description": "Per-user reaction state keyed by UID to prevent duplicate likes."
    },
    "/posts/{postId}/comments/{commentId}": {
      "schema": {
        "$ref": "#/entities/Comment"
      },
      "description": "Comments and replies on a post."
    },
    "/communities/{communityId}": {
      "schema": {
        "$ref": "#/entities/Community"
      },
      "description": "Anime communities with category, tags, visibility, rules, owner, and moderator roster."
    },
    "/communities/{communityId}/posts/{postId}": {
      "schema": {
        "$ref": "#/entities/Post"
      },
      "description": "Discussion posts scoped to a specific community; private communities restrict read/write to members."
    },
    "/communities/{communityId}/posts/{postId}/reactions/{userId}": {
      "schema": {
        "$ref": "#/entities/PostReaction"
      },
      "description": "Per-user reactions on a community discussion post."
    },
    "/communities/{communityId}/posts/{postId}/comments/{commentId}": {
      "schema": {
        "$ref": "#/entities/Comment"
      },
      "description": "Comments and replies on a community discussion post."
    },
    "/communitySlugs/{slug}": {
      "schema": {
        "$ref": "#/entities/CommunitySlugReservation"
      },
      "description": "Unique slug reservation registry for communities."
    },
    "/communityMemberships/{membershipId}": {
      "schema": {
        "$ref": "#/entities/CommunityMembership"
      },
      "description": "Community membership and RBAC role assignments keyed by {communityId}__{userId}."
    },
    "/communityJoinRequests/{requestId}": {
      "schema": {
        "$ref": "#/entities/CommunityJoinRequest"
      },
      "description": "Private community join requests keyed by {communityId}__{userId}."
    },
    "/communityRateLimits/{userId}": {
      "schema": {
        "$ref": "#/entities/CommunityRateLimit"
      },
      "description": "Server-time rate limiting checkpoints for community creation spam prevention."
    },
    "/follows/{followId}": {
      "schema": {
        "$ref": "#/entities/FollowRelationship"
      },
      "description": "Follow relationships keyed by {followerId}__{followingId}."
    },
    "/blocks/{blockId}": {
      "schema": {
        "$ref": "#/entities/BlockRelationship"
      },
      "description": "User block relationships keyed by {blockerId}__{blockedId}."
    },
    "/reports/{reportId}": {
      "schema": {
        "$ref": "#/entities/ModerationReport"
      },
      "description": "Non-public moderation reports for posts, comments, and communities."
    },
    "/postRateLimits/{userId}": {
      "schema": {
        "$ref": "#/entities/PostRateLimit"
      },
      "description": "Server-time rate limiting checkpoints for post spam prevention."
    },
    "/commentRateLimits/{userId}": {
      "schema": {
        "$ref": "#/entities/CommentRateLimit"
      },
      "description": "Server-time rate limiting checkpoints for comment spam prevention."
    },
    "/messageSettings/{userId}": {
      "schema": {
        "$ref": "#/entities/MessageSettings"
      },
      "description": "Per-user private messaging privacy and indicator settings."
    },
    "/userPresence/{userId}": {
      "schema": {
        "$ref": "#/entities/UserPresence"
      },
      "description": "Conservative last-active status visible only when enabled and not blocked."
    },
    "/conversations/{conversationId}": {
      "schema": {
        "$ref": "#/entities/Conversation"
      },
      "description": "Private 1:1 and group conversation threads accessible strictly to active participants."
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": {
        "$ref": "#/entities/Message"
      },
      "description": "Real-time messages inside a private conversation."
