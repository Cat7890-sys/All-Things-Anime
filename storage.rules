rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Global default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isAdminClaim() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.ataAdminRole in ['owner', 'platform_admin', 'content_admin'];
    }

    // Post images: public read, verified-owner upload up to 5 MB for allowed image MIME types
    match /posts/{userId}/{postId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.auth.token.email_verified == true
        && request.resource != null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
      allow delete: if (request.auth != null
        && request.auth.uid == userId
        && request.auth.token.email_verified == true) || isAdminClaim();
    }

    // Community cover & avatar images: public read, verified uploader up to 5 MB for allowed image MIME types
    match /communities/{userId}/{communityId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.auth.token.email_verified == true
        && request.resource != null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
      allow delete: if (request.auth != null
        && request.auth.uid == userId
        && request.auth.token.email_verified == true) || isAdminClaim();
    }

    // Private group conversation avatar images: authenticated read, verified uploader up to 5 MB
    match /groups/{userId}/{conversationId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.auth.token.email_verified == true
        && request.resource != null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
      allow delete: if (request.auth != null
        && request.auth.uid == userId
        && request.auth.token.email_verified == true) || isAdminClaim();
    }
  }
}
