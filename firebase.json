{
  "firestore": {
    "database": "ai-studio-ataallthingsanim-42a903d6-0b6a-478d-9d62-c82df4c9e0e2",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
